{
  "name": "wayve",
  "version": "0.1.0",
  "private": true,
  "description": "WAYVE — phones become live sensors for a shared venue map",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --no-warnings --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --no-warnings --import ./server/early.js server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings --test \"test/**/*.test.ts\"",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "openai": "^7.45.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/cal-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.65.0",
    "motion": "^14.8.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "vaul": "^1.1.2",
    "vite": "^8.3.5"
  }
}
