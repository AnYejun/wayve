# WAYVE — copy to .env for local dev. Never commit real values.
PORT=8080
PUBLIC_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Leave empty to run without AI: vision is disabled and phones use the manual observation fallback.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REASONING_EFFORT=none

# Optional: event Wi-Fi password the assistants may share with attendees (kept out of git; set as a Fly secret in production)
EVENT_WIFI_PASSWORD=
